rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@savit.com';
    }

    // ── Productos: lectura pública, escritura solo admin
    match /products/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Categorías: lectura pública, escritura solo admin
    match /categories/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Configuración de tienda: lectura pública, escritura solo admin
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Pedidos: lectura y creación públicas, pero modificación/borrado solo admin
    match /orders/{doc} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // ── Notificaciones: lectura y creación públicas, modificación/borrado solo admin
    match /notifications/{doc} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // ── Ingredientes: lectura pública, escritura solo admin
    match /ingredients/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Ofertas: lectura pública, escritura solo admin
    match /offers/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Subscripciones: solo admin
    match /subscriptions/{doc} {
      allow read, write: if isAdmin();
    }

    // ── Logs de admin: solo admin
    match /adminLogs/{doc} {
      allow read, write: if isAdmin();
    }

    // ── Perfiles de usuario: el usuario solo ve/edita el suyo, admin todo
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // ── Recompensas y puntos de fidelidad: lectura pública, escritura admin
    match /rewards/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
