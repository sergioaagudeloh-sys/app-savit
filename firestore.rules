rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Productos: lectura pública, escritura solo admin autenticado
    match /products/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Categorías: lectura pública, escritura solo admin autenticado
    match /categories/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Configuración de tienda: lectura pública, escritura solo admin
    match /config/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Pedidos: lectura/escritura públicas (clientes sin cuenta crean pedidos)
    match /orders/{doc} {
      allow read, write: if true;
    }

    // ── Notificaciones: lectura/escritura públicas (sistema de notificaciones en tiempo real)
    match /notifications/{doc} {
      allow read, write: if true;
    }

    // ── Ingredientes: lectura pública, escritura solo admin
    match /ingredients/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Ofertas: lectura pública, escritura solo admin
    match /offers/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Subscripciones: solo admin autenticado
    match /subscriptions/{doc} {
      allow read, write: if request.auth != null;
    }

    // ── Logs de admin: solo admin autenticado puede leer/escribir
    match /adminLogs/{doc} {
      allow read, write: if request.auth != null;
    }

    // ── Perfiles de usuario
    match /users/{userId} {
      allow read, write: if true;
    }

    // ── Recompensas y puntos de fidelidad
    match /rewards/{doc} {
      allow read, write: if true;
    }
  }
}
